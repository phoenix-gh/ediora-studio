{
  "manifest_version": 3,
  "name": "述策助手",
  "version": "0.1.0",
  "description": "在 X 页面查看 WeMediaStudio 草稿并记住原生安排表的最后选择。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content/workbench.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/selectors.js",
        "content/draft-client.js",
        "content/draft-model.js",
        "content/markdown-renderer.js",
        "content/workbench-clipboard.js",
        "content/workbench-runtime.js",
        "content/workbench-state.js",
        "content/schedule-memory.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
