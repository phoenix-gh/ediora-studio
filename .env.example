POSTGRES_PASSWORD=change-me
# Configure LLM, image, speech, HeyGen, and other provider credentials in the
# Settings page after the PostgreSQL service is ready. Provider API keys are
# intentionally not read from this file.
# Shared only by the Python API and Node worker. Must contain at least 32
# characters; startup fails closed when it is missing or shorter.
WORKER_TOKEN=
# Stable Fernet key for encrypted X account sessions. If empty, the API derives
# one from WORKER_TOKEN; keep either value unchanged across environments.
X_SESSION_KEY=
WORKER_QUEUE=content-jobs
VIDEO_WORKER_QUEUE=content-jobs:video
# The installer derives this from WEB_PORT; override for a custom domain or reverse proxy.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_PORT=8000
WEB_PORT=3000
# The installer derives this from API_PORT; override for a custom domain or reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# 前端开发者模式；开启后才显示 Agent 运行轨迹、AI 完整消息和执行事件
NEXT_PUBLIC_DEVELOPER_MODE=0
# To run the published GHCR image instead of building locally:
# APP_IMAGE=ghcr.io/phoenix-gh/ediora-studio
# IMAGE_TAG=latest
