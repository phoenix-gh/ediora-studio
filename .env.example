POSTGRES_PASSWORD=change-me
# Configure model and image provider keys in the server environment before
# starting a content job. Never prefix these values with NEXT_PUBLIC_.
WMS_LLM_API_KEY=
WMS_LLM_MODEL=gpt-4o-mini
WMS_LLM_BASE_URL=
IMAGE_API_KEY=
WMS_IMAGE_API_KEY=
WMS_IMAGE_MODEL=gpt-image-1
WMS_IMAGE_BASE_URL=
HEYGEN_API_KEY=
# Speech synthesis credentials stay on the API/worker side. Configure the API
# key here or save it from Settings > Speech synthesis.
WMS_SPEECH_PROVIDER=mimo
WMS_SPEECH_MODEL=mimo-v2.5-tts
WMS_SPEECH_BASE_URL=https://api.xiaomimimo.com/v1
WMS_SPEECH_API_KEY=
WMS_SPEECH_DEFAULT_VOICE=mimo_default
# Shared only by the Python API and Node worker. Must contain at least 32
# characters; startup fails closed when it is missing or shorter.
WMS_WORKER_TOKEN=
# Stable Fernet key for encrypted X account sessions. If empty, the API derives
# one from WMS_WORKER_TOKEN; keep either value unchanged across environments.
WMS_X_SESSION_KEY=
WMS_WORKER_QUEUE=content-jobs
WMS_VIDEO_WORKER_QUEUE=content-jobs:video
WMS_CORS_ORIGINS=http://localhost:3000
WMS_API_PORT=8000
WMS_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# To run the published GHCR image instead of building locally:
# WMS_APP_IMAGE=ghcr.io/phoenix-gh/ediora-studio
# WMS_IMAGE_TAG=latest
