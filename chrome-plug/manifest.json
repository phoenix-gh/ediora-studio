{
    "manifest_version": 3,
    "name": "X Post Analyzer",
    "version": "1.1",
    "permissions": ["activeTab", "scripting", "storage"],
    "host_permissions": ["https://x.com/*", "http://localhost/*"],
    "content_scripts": [
      {
        "matches": ["https://x.com/*"],
        "js": ["content.js", "toolbar.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }
